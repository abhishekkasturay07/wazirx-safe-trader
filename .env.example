# Paper mode is the safe default. Live mode additionally requires confirmation, API keys and dashboard authentication.
LIVE_MODE=false
PAUSE_NEW_ENTRIES=false
LIVE_CONFIRMATION=
WAZIRX_API_KEY=
WAZIRX_SECRET_KEY=

SYMBOLS=btcinr,ethinr,xrpinr,solinr
LIQUID_SYMBOLS=btcinr,ethinr,xrpinr,solinr,usdtinr,shibinr,wrxinr,trxinr
CANDLE_INTERVAL=1h
SCAN_CRON=5 * * * *
STARTING_CAPITAL_INR=2000
MAX_POSITION_INR=400
INITIAL_POSITION_INR=240
ADD_POSITION_INR=0
ADD_TRIGGER_PERCENT=1
MAX_OPEN_POSITIONS=2
MAX_RISK_PER_TRADE_PERCENT=0.5
MAX_SPREAD_PERCENT=0.30
MAX_ESTIMATED_SLIPPAGE_PERCENT=0.25
MIN_24H_QUOTE_VOLUME_INR=10000000
MIN_SIGNAL_SCORE=75
STOP_LOSS_PERCENT=2
TRAILING_STOP_PERCENT=2
FIRST_TAKE_PROFIT_PERCENT=4
FIRST_SELL_PERCENT=50
SECOND_TAKE_PROFIT_PERCENT=7
SECOND_SELL_PERCENT=25
COOLDOWN_CANDLES=4
MAX_HOLDING_HOURS=48
WEBSOCKET_ENABLED=true
WEBSOCKET_STALE_SECONDS=20
WEBSOCKET_RECONNECT_MAX_SECONDS=30
PRICE_TRIGGER_COOLDOWN_MS=5000
DAILY_LOSS_LIMIT_INR=60
DAILY_LOSS_PERCENT=1
MAX_CONSECUTIVE_LOSSES=2
# Set this to the fee actually charged on your account's fills; WazirX fees can vary by plan/tier.
TRADING_FEE_PERCENT=0.2
STALE_ORDER_MINUTES=30

# Optional. When set, it protects the dashboard/API; use at least 16 characters.
DASHBOARD_USER=trader
DASHBOARD_PASSWORD=

PORT=3000
DATABASE_PATH=./data/trader.db
EMAIL_ENABLED=true
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_TO=
