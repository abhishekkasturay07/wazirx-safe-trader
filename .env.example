# Paper mode is the safe default. Live mode additionally requires LIVE_CONFIRMATION.
LIVE_MODE=false
LIVE_CONFIRMATION=
WAZIRX_API_KEY=
WAZIRX_SECRET_KEY=

SYMBOLS=btcinr,ethinr,xrpinr,solinr
CANDLE_INTERVAL=15m
SCAN_CRON=*/15 * * * *
STARTING_CAPITAL_INR=2000
MAX_POSITION_INR=400
MAX_OPEN_POSITIONS=2
MIN_SIGNAL_SCORE=75
STOP_LOSS_PERCENT=2
TARGET_PERCENT=4
TRAILING_STOP_PERCENT=2
DAILY_LOSS_LIMIT_INR=60
MAX_CONSECUTIVE_LOSSES=3
TRADING_FEE_PERCENT=0.2

PORT=3000
DATABASE_PATH=./data/trader.db
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_TO=
